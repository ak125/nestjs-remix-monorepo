{
"permissions": {
    "allow": []
  },
  "enabledPlugins": {
    "remember@claude-plugins-official": false,
    "goodmem@claude-plugins-official": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash /opt/automecanik/app/scripts/claude-hooks/pretool-bash-guard.sh",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /opt/automecanik/app/scripts/claude-hooks/pretool-file-guard.sh",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "mcp__(supabase|claude_ai_Supabase)__(apply_migration|execute_sql)",
        "hooks": [
          {
            "type": "command",
            "command": "bash /opt/automecanik/app/scripts/claude-hooks/pretool-supabase-guard.sh",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Agent|TeamCreate",
        "hooks": [
          {
            "type": "command",
            "command": "bash /opt/automecanik/app/scripts/claude-hooks/pretool-agent-guard.sh",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash /opt/automecanik/app/scripts/claude-hooks/posttool-lint-check.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /opt/automecanik/app/scripts/claude-hooks/stop-log-session-suggest.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /opt/automecanik/app/scripts/claude-hooks/sessionstart-workspace-context.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_SHIP": "1"
  }
}
