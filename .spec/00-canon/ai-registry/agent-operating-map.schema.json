{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automecanik.com/canon/agent-operating-map.schema.json",
  "title": "AI Agent Operating Map (reference projection)",
  "description": "Non-authoritative reference projection of the monorepo's AI surfaces, nodes (skills/agents), and inter-workspace handoffs. Department contracts (field `contract`) are hard-failed in CI (owner decision 72, 2026-11-15); other findings stay warn-only.",
  "type": "object",
  "required": ["version", "last_verified", "surfaces", "nodes", "handoffs"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "last_verified": { "type": "string", "format": "date" },
    "surfaces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/surface" } },
    "nodes":    { "type": "array", "minItems": 0, "items": { "$ref": "#/$defs/node" } },
    "handoffs": { "type": "array", "items": { "$ref": "#/$defs/handoff" } },
    "departments":           { "type": "array", "items": { "$ref": "#/$defs/department" } },
    "declared_capabilities": { "type": "array", "items": { "$ref": "#/$defs/declaredCapability" } },
    "department_handoffs":   { "type": "array", "items": { "$ref": "#/$defs/departmentHandoff" } },
    "function_coverage_unassigned": {
      "description": "Existing elements attached to no department function yet (complement BX-2), each with the reason. The validator's coverage report lists them apart from the elements nobody has looked at.",
      "type": "array",
      "items": { "allOf": [{ "$ref": "#/$defs/coverageElement" }, { "required": ["reason"] }] }
    },
    "department_contract_common": { "$ref": "#/$defs/departmentContractCommon" }
  },
  "dependentRequired": { "departments": ["department_contract_common"] },
  "$defs": {
    "surfaceId":   { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "nodeId":      { "type": "string", "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$" },
    "externalRef": { "type": "string", "pattern": "^external:[a-z][a-z0-9_-]*$" },
    "nodeOrExternal": { "oneOf": [ { "$ref": "#/$defs/nodeId" }, { "$ref": "#/$defs/externalRef" } ] },
    "surface": {
      "type": "object",
      "required": ["id", "cwd", "role", "purpose", "capabilities", "loads"],
      "additionalProperties": false,
      "properties": {
        "id":       { "$ref": "#/$defs/surfaceId" },
        "cwd":      { "type": "string", "minLength": 1 },
        "role":     { "enum": ["dev", "content", "marketing", "knowledge", "advisory"] },
        "purpose":  { "type": "string", "minLength": 5 },
        "capabilities": { "$ref": "#/$defs/capabilityFlags" },
        "loads": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "skills": { "type": "array", "items": { "$ref": "#/$defs/nodeId" } },
            "agents": { "type": "array", "items": { "$ref": "#/$defs/nodeId" } }
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "path", "owner", "domain"],
      "additionalProperties": false,
      "properties": {
        "id":     { "$ref": "#/$defs/nodeId" },
        "type":   { "enum": ["skill", "agent"] },
        "path":   { "type": "string", "minLength": 1 },
        "owner":  { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "pattern": "^(D([1-9]|1[0-5])|UNKNOWN)$" }
      }
    },
    "handoff": {
      "type": "object",
      "required": ["id", "from", "to", "produced_by", "consumed_by", "input_contract", "output_contract", "gate", "state"],
      "additionalProperties": false,
      "properties": {
        "id":   { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "from": { "oneOf": [ { "$ref": "#/$defs/surfaceId" }, { "$ref": "#/$defs/externalRef" } ] },
        "to":   { "oneOf": [ { "$ref": "#/$defs/surfaceId" }, { "$ref": "#/$defs/externalRef" } ] },
        "produced_by": { "oneOf": [ { "$ref": "#/$defs/nodeOrExternal" }, { "type": "array", "items": { "$ref": "#/$defs/nodeOrExternal" }, "minItems": 1 } ] },
        "consumed_by": { "oneOf": [ { "$ref": "#/$defs/nodeOrExternal" }, { "type": "array", "items": { "$ref": "#/$defs/nodeOrExternal" }, "minItems": 1 } ] },
        "input_contract":  { "type": "string", "minLength": 1 },
        "output_contract": { "type": "string", "minLength": 1 },
        "gate":  { "type": "string", "minLength": 1 },
        "state": { "enum": ["EXISTS", "PARTIAL", "ASPIRATIONAL"] },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "adr":     { "type": "string", "pattern": "^ADR-\\d{3,4}$" },
            "scripts": { "type": "array", "items": { "type": "string" } },
            "tables":  { "type": "array", "items": { "type": "string" } },
            "skills":  { "type": "array", "items": { "$ref": "#/$defs/nodeId" } }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "departmentId":  { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "repoDomainId":  { "type": "string", "pattern": "^D([1-9]|1[0-6])$" },
    "capabilityRef": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "declaredCapability": {
      "type": "object",
      "required": ["id", "type", "owner", "status"],
      "additionalProperties": false,
      "properties": {
        "id":     { "$ref": "#/$defs/capabilityRef" },
        "type":   { "enum": ["skill", "agent", "service", "module", "engine", "pipeline", "signal"] },
        "owner":  { "$ref": "#/$defs/departmentId" },
        "status": { "enum": ["live", "partial", "dormant", "broken", "duplicate"] },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runtime": { "type": "string" },
            "adr":     { "type": "string", "pattern": "^ADR-\\d{3,4}$" },
            "scripts": { "type": "array", "items": { "type": "string" } },
            "tables":  { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "department": {
      "type": "object",
      "required": [
        "id",
        "label",
        "lead",
        "repo_domains",
        "state",
        "business_number",
        "accountable_owner",
        "operating_mode",
        "profile_ref",
        "contract"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/departmentId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "lead": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "kpi_primary": {
          "type": "string",
          "minLength": 1
        },
        "repo_domains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repoDomainId"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityRef"
          }
        },
        "state": {
          "enum": [
            "live",
            "partial",
            "dormant",
            "broken",
            "duplicate"
          ]
        },
        "business_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "accountable_owner": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "operating_mode": {
          "enum": [
            "human",
            "software",
            "hybrid"
          ]
        },
        "profile_ref": {
          "type": "string",
          "pattern": "^audit/automecanik-departments-map\\.md#department-[a-z0-9-]+$"
        },
        "contract": {
          "$ref": "#/$defs/departmentContract"
        },
        "functions": {
          "description": "Optional (mandate BX, 2026-11-18): the department's functions, each a service with a contract, an owner, a real trigger, an automatic check, its input KPIs, its threshold and its proven level (L0-L4 of the principles journal). Coherence rules beyond the schema are enforced by validate-agent-operating-map.js (--contracts). Model: .spec/00-canon/ai-registry/department-functions.md.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/departmentFunction" }
        }
      },
      "if": {
        "properties": {
          "operating_mode": {
            "enum": [
              "software",
              "hybrid"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "repo_domains": {
            "minItems": 1
          }
        }
      }
    },
    "pendingOwnerDecision": {
      "description": "Explicit gap: the field is not filled because the owner has not decided it yet. The reason says what is missing; it is surfaced by the validator, never treated as a value.",
      "type": "object",
      "required": ["pending_owner_decision"],
      "additionalProperties": false,
      "properties": {
        "pending_owner_decision": { "type": "string", "minLength": 10 }
      }
    },
    "contractText": {
      "oneOf": [
        { "type": "string", "minLength": 3 },
        { "$ref": "#/$defs/pendingOwnerDecision" }
      ]
    },
    "departmentContract": {
      "description": "Department contract (decision 72 of the owner, 2026-11-15/16): what the department watches, its KPI, the source read, the action threshold and its line in the department report, with the owner decisions it applies, cited by number. A field may be an explicit pending_owner_decision; it may not be absent or empty.",
      "type": "object",
      "required": ["surveillance", "kpi", "source", "seuil_action", "ligne_rapport", "decisions"],
      "additionalProperties": false,
      "properties": {
        "surveillance": { "$ref": "#/$defs/contractText" },
        "kpi": {
          "oneOf": [
            {
              "type": "object",
              "required": ["producer"],
              "additionalProperties": false,
              "properties": {
                "producer": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+\\.(ts|js|mjs|cjs|sql|py|sh)$" },
                "rule": { "type": "string", "minLength": 3 },
                "definition": { "type": "string", "minLength": 10 }
              }
            },
            {
              "description": "KPI defined by an owner decision but not produced yet: `definition` is what the decision measures, `producer_pending` says what is missing (producer, reliability sheet of decision 8). Listed by the validator, never treated as a measure.",
              "type": "object",
              "required": ["definition", "producer_pending"],
              "additionalProperties": false,
              "properties": {
                "definition": { "type": "string", "minLength": 10 },
                "producer_pending": { "type": "string", "minLength": 10 }
              }
            },
            {
              "description": "The department carries no KPI of its own, by a documented organisation decision.",
              "type": "object",
              "required": ["none"],
              "additionalProperties": false,
              "properties": {
                "none": { "type": "string", "minLength": 10 }
              }
            },
            { "$ref": "#/$defs/pendingOwnerDecision" }
          ]
        },
        "source":{ "$ref": "#/$defs/contractText" },
        "seuil_action": { "$ref": "#/$defs/contractText" },
        "ligne_rapport": { "$ref": "#/$defs/contractText" },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 90 }
        }
      }
    },
    "departmentContractCommon": {
      "description": "Rules shared by every department contract (owner decisions cited by number): the single report, the KPI entry condition, what a crossed threshold opens, the missing-data wording and the measurement sources.",
      "type": "object",
      "required": ["rapport", "entree_kpi", "seuil_franchi", "donnee_absente", "sources"],
      "additionalProperties": false,
      "properties": {
        "rapport":        { "$ref": "#/$defs/contractCommonRule" },
        "entree_kpi":     { "$ref": "#/$defs/contractCommonRule" },
        "seuil_franchi":  { "$ref": "#/$defs/contractCommonRule" },
        "donnee_absente": { "$ref": "#/$defs/contractCommonRule" },
        "sources":        { "$ref": "#/$defs/contractCommonRule" }
      }
    },
    "contractCommonRule": {
      "type": "object",
      "required": ["regle", "decisions"],
      "additionalProperties": false,
      "properties": {
        "regle": { "type": "string", "minLength": 10 },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 90 }
        }
      }
    },
    "capabilityFlags": {
      "description": "Least-privilege rights, shared by a surface and a department function.",
      "type": "object",
      "required": ["can_mutate", "can_open_pr", "can_trigger_pipeline"],
      "additionalProperties": false,
      "properties": {
        "can_mutate":           { "type": "boolean" },
        "can_open_pr":          { "type": "boolean" },
        "can_trigger_pipeline": { "type": "boolean" }
      }
    },
    "repoPath": {
      "description": "Path relative to the repository root; the validator requires it to exist.",
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_.@][A-Za-z0-9_./@-]*$"
    },
    "functionTrigger": {
      "description": "What starts the function. `wired` is true only when the trigger really fires on main (a @Cron under an inactive ScheduleModule, or an event nobody emits, is wired: false).",
      "type": "object",
      "required": ["kind", "ref", "wired"],
      "additionalProperties": false,
      "properties": {
        "kind":   { "enum": ["workflow", "cron", "event", "issue", "mandate", "request"] },
        "ref":    { "$ref": "#/$defs/repoPath" },
        "wired":  { "type": "boolean" },
        "detail": { "type": "string", "minLength": 3 }
      }
    },
    "functionCheck": {
      "description": "The automatic check that proves the function's contract (a test run in CI, a gate, a workflow).",
      "type": "object",
      "required": ["kind", "ref"],
      "additionalProperties": false,
      "properties": {
        "kind":   { "enum": ["test", "ci_gate", "workflow"] },
        "ref":    { "$ref": "#/$defs/repoPath" },
        "detail": { "type": "string", "minLength": 3 }
      }
    },
    "functionKpiInput": {
      "description": "Input KPI of a function (the department's kpi_primary is the result KPI). `present` requires a producer on disk; `absent` says what is missing.",
      "type": "object",
      "required": ["id", "state"],
      "additionalProperties": false,
      "properties": {
        "id":       { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "state":    { "enum": ["present", "absent"] },
        "producer": { "$ref": "#/$defs/repoPath" },
        "rule":     { "type": "string", "minLength": 3 },
        "note":     { "type": "string", "minLength": 3 }
      },
      "if": { "properties": { "state": { "const": "present" } } },
      "then": { "required": ["producer"] },
      "else": { "required": ["note"] }
    },
    "functionThreshold": {
      "description": "Threshold that opens a dept:NN issue (decision 9). `wired` is true only when something actually opens the issue.",
      "type": "object",
      "required": ["rule", "issue_label", "wired"],
      "additionalProperties": false,
      "properties": {
        "rule":        { "type": "string", "minLength": 3 },
        "issue_label": { "type": "string", "pattern": "^dept:\\d{2}-[a-z0-9-]+$" },
        "wired":       { "type": "boolean" }
      }
    },
    "functionEvidence": {
      "oneOf": [
        {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": {
            "path":  { "$ref": "#/$defs/repoPath" },
            "lines": { "type": "string", "pattern": "^[1-9]\\d*(-[1-9]\\d*)?$" },
            "note":  { "type": "string", "minLength": 3 }
          }
        },
        {
          "type": "object",
          "required": ["pr", "state"],
          "additionalProperties": false,
          "properties": {
            "pr":    { "type": "integer", "minimum": 1 },
            "state": { "enum": ["merged", "open", "draft", "closed"] },
            "at":    { "type": "string", "format": "date-time" },
            "note":  { "type": "string", "minLength": 3 }
          }
        },
        {
          "type": "object",
          "required": ["run", "workflow", "conclusion", "at"],
          "additionalProperties": false,
          "properties": {
            "run":        { "type": "integer", "minimum": 1 },
            "workflow":   { "$ref": "#/$defs/repoPath" },
            "conclusion": { "enum": ["success", "failure", "cancelled", "skipped"] },
            "at":         { "type": "string", "format": "date-time" },
            "note":       { "type": "string", "minLength": 3 }
          }
        },
        {
          "description": "No proof in the repository: only for a missing function (rule enforced by the validator).",
          "type": "object",
          "required": ["absent"],
          "additionalProperties": false,
          "properties": {
            "absent": { "type": "string", "minLength": 10 }
          }
        }
      ]
    },
    "coverageElement": {
      "description": "One existing element a function covers (complement BX-2): a backend module, a route prefix (by dot segment, `_` suffixes dropped) or one exact route, a workflow, a file holding @Cron, or a line of the DEV deploy crontab (cited, not checkable in CI).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module":   { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "routes":   { "type": "string", "minLength": 1 },
        "route":    { "type": "string", "minLength": 1 },
        "workflow": { "$ref": "#/$defs/repoPath" },
        "cron":     { "$ref": "#/$defs/repoPath" },
        "crontab":  { "type": "integer", "minimum": 1 },
        "script":   { "type": "string", "minLength": 3 },
        "note":     { "type": "string", "minLength": 3 },
        "reason":   { "type": "string", "minLength": 10 }
      },
      "oneOf": [
        { "required": ["module"] },
        { "required": ["routes"] },
        { "required": ["route"] },
        { "required": ["workflow"] },
        { "required": ["cron"] },
        { "required": ["crontab", "script"] }
      ]
    },
    "departmentFunction": {
      "description": "One department function (mandate BX, complement BX-2). Without an owner, a wired trigger and a check, it cannot be operational and stays at L0 or L1 (rule enforced by the validator). A missing function is a proposal: L0, a justification, no covers, evidence `absent`.",
      "type": "object",
      "required": ["id", "name", "owner", "status", "level", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id":      { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$" },
        "name":    { "type": "string", "minLength": 3 },
        "owner":   { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "status":  { "enum": ["operational", "non_operational", "missing"] },
        "level":   { "enum": ["L0", "L1", "L2", "L3", "L4"] },
        "inputs":  { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "outputs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
        "reads":   { "type": "array", "items": { "type": "string", "minLength": 2 } },
        "writes":  { "type": "array", "items": { "type": "string", "minLength": 2 } },
        "trigger": { "$ref": "#/$defs/functionTrigger" },
        "check":   { "$ref": "#/$defs/functionCheck" },
        "kpi_input": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/functionKpiInput" } },
        "threshold": { "$ref": "#/$defs/functionThreshold" },
        "rights":  { "$ref": "#/$defs/capabilityFlags" },
        "uses": {
          "description": "Shared capabilities consumed by contract; the capability stays with the department that owns it in declared_capabilities.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["capability", "from"],
            "additionalProperties": false,
            "properties": {
              "capability": { "$ref": "#/$defs/capabilityRef" },
              "from":       { "$ref": "#/$defs/departmentId" }
            }
          }
        },
        "agents":   { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "skills":   { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/functionEvidence" } },
        "decisions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "gaps":     { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
        "covers":   { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/coverageElement" } },
        "justification": { "type": "string", "minLength": 20 }
      },
      "if": { "properties": { "status": { "const": "missing" } } },
      "then": {
        "required": ["justification"],
        "properties": { "level": { "const": "L0" } },
        "not": { "required": ["covers"] }
      }
    },
    "departmentHandoff": {
      "type": "object",
      "required": ["id", "from", "to", "contract_ref", "contract_status", "gate", "state"],
      "additionalProperties": false,
      "properties": {
        "id":              { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "from":            { "$ref": "#/$defs/departmentId" },
        "to":              { "$ref": "#/$defs/departmentId" },
        "contract_ref":    { "type": "string", "minLength": 1 },
        "contract_status": { "enum": ["planned", "defined"] },
        "purpose":         { "type": "string", "minLength": 1 },
        "gate":            { "type": "string", "minLength": 1 },
        "state":           { "enum": ["EXISTS", "PARTIAL", "ASPIRATIONAL"] },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "runtime": { "type": "string" },
            "adr":     { "type": "string", "pattern": "^ADR-\\d{3,4}$" },
            "scripts": { "type": "array", "items": { "type": "string" } },
            "tables":  { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
