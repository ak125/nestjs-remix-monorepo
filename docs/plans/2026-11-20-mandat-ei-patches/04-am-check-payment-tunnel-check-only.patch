+fi
+
+# CHECK_ONLY : une ligne d'état agrégée en sortie, seulement si la lecture a abouti
+# (code 0 = aucune règle, 3 = règle déclenchée). Jamais d'identifiant de commande.
+check_only_report() {
+  local rc=$? rule=none
+  [ "$CHECK_ONLY" = "1" ] || return 0
+  case "$rc" in 0|3) ;; *) return 0 ;; esac
+  case "${ALERT_SUBJECT:-}" in
+    *"ORDER CREATION"*) rule=CREATION ;;
+    *"No payment"*) rule=SUSTAINED ;;
+    *"Payment tunnel"*) rule=BURST ;;
+  esac
+  printf 'CHECK_ONLY_RESULT rule=%s silence_days=%s unpaid_since_last=%s orders_window=%s paid_window=%s window_hours=%s oc_completed=%s oc_failed=%s\n' \
+    "$rule" "${silence_days:--1}" "${unpaid_since_last:--1}" "${orders_count:--1}" "${paid_count:--1}" \
+    "${WINDOW_HOURS:-?}" "${oc_completed:--1}" "${oc_failed:--1}"
+}
+trap check_only_report EXIT
 
 WINDOW_HOURS="${WINDOW_HOURS:-2}"
 MIN_ORDERS_THRESHOLD="${MIN_ORDERS_THRESHOLD:-2}"
