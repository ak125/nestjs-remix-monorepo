exports[`RobotsTxtService — caractérisation production (NODE_ENV=production) 1`] = `
"# ===========================================
# 🤖 ROBOTS.TXT PRODUCTION - AutoMecanik.com
# ===========================================
# Migré depuis PHP le 2026-09-11
# Structure alignée sur l'ancien système
