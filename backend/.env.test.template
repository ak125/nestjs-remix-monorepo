# ===============================================
# DATABASE CONFIGURATION - SUPABASE REST API
# ===============================================
# ✅ Nous utilisons uniquement l'API REST Supabase
# ❌ Pas de connexion PostgreSQL directe (DATABASE_URL supprimé)
# ✅ Tous les services héritent de SupabaseBaseService

# 🔐 AUCUN secret reel ici — ce fichier est commite dans un depot PUBLIC.
#    Copier vers `.env.test` (gitignore) et remplir depuis le vault.
#    Format Supabase courant : sb_publishable_… / sb_secret_…
#    Les JWT legacy (eyJ…) sont proscrits : voir audit/baselines/revoked-secrets-baseline.json

SUPABASE_URL="https://cxpojprgwgubzjyqzmoq.supabase.co"
SUPABASE_ANON_KEY="sb_publishable_<recuperer-depuis-le-vault>"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_<recuperer-depuis-le-vault>"

REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
SESSION_SECRET="<generer-via-openssl-rand-hex-32>"

# Analytics Configuration
ANALYTICS_ENABLED=true
ANALYTICS_PROVIDER="google"
ANALYTICS_GOOGLE_ID="GA_MEASUREMENT_ID_TEST"

# ===============================================
# EMAIL SERVICE - RESEND
# ===============================================
# Obtenir votre clé sur https://resend.com/api-keys
# Format: re_xxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY="re_<recuperer-depuis-le-vault>"
EMAIL_FROM="onboarding@resend.dev"
APP_URL="http://localhost:5173"

# ===============================================
# TEST & DEVELOPMENT ONLY
# ===============================================
# Credentials pour le endpoint /auth/debug-users (dev/test uniquement)
# ⚠️ CES VARIABLES NE DOIVENT JAMAIS ÊTRE UTILISÉES EN PRODUCTION
