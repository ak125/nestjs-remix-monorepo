# ===============================================
# PAYMENT GATEWAY - SystemPay/Lyra (BNP Paribas)
# ===============================================
# Documentation: https://paiement.systempay.fr/doc/
# ⚠️  IMPORTANT : Utilisez des credentials différents pour TEST et PRODUCTION

# Identifiant du site marchand
SYSTEMPAY_SITE_ID=43962882

# Certificats (clés secrètes - NE JAMAIS LOGGER)
SYSTEMPAY_CERTIFICATE_PROD=9816635272016068
SYSTEMPAY_CERTIFICATE_TEST=9300172162563656

# Mode: PRODUCTION ou TEST
SYSTEMPAY_MODE=PRODUCTION

# URL du gateway de paiement
SYSTEMPAY_API_URL=https://paiement.systempay.fr/vads-payment/

# URL de base de l'application (pour les callbacks)
APP_URL=http://localhost:5173

# Base URL for payment callbacks
BASE_URL="https://www.automecanik.com"

# Méthode de signature SystemPay (HMAC = DSP2 canon, SHA1 = legacy)
SYSTEMPAY_SIGNATURE_METHOD=HMAC

# Clés HMAC SystemPay
SYSTEMPAY_HMAC_KEY_TEST=7731B4225651B0C434189E2A13B963F91D8BBE78AEC97838E40925569E25357373C792E2FBE5A6B8C0CBC12ED27524CC2EE0C4653C93A14A39414AA42F85AEE5
SYSTEMPAY_HMAC_KEY_PROD=VOTRE_CLE_HMAC_PRODUCTION_ICI

# ===============================================
# PAYBOX/VERIFONE - Configuration TEST avec identifiants PRODUCTION
# ===============================================
# Documentation: https://www1.paybox.com/espace-integrateur-documentation/
# ⚠️  Configuration identique au PHP actuel : identifiants PROD + clé TEST

# Identifiants Paybox PRODUCTION
PAYBOX_SITE=VOTRE_SITE_TEST
PAYBOX_RANG=VOTRE_RANG_TEST
PAYBOX_IDENTIFIANT=VOTRE_IDENTIFIANT_TEST

# Clé HMAC TEST pour signature (HMAC-SHA512)
# ✅ Même clé que dans le PHP actuel ($CertificatTest)
PAYBOX_HMAC_KEY=VOTRE_CLE_HMAC_TEST_128_CARACTERES

# URL de paiement (PRODUCTION car identifiants PROD)
# Même si on utilise une clé TEST, on doit pointer vers la prod
PAYBOX_URL=https://tpeweb.paybox.com/cgi/MYchoix_pagepaiement.cgi

# Devise (978 = EUR)
PAYBOX_DEVISE=978

# PAYBOX MODE (TEST signifie "clé de test" mais endpoint PROD)
PAYBOX_MODE=TEST
PAYBOX_PAYMENT_URL=https://preprod-tpeweb.paybox.com/cgi/MYchoix_pagepaiement.cgi

