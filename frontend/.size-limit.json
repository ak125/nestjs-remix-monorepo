[
  {
    "name": "Initial load JS (static-import closure of entry.client + root), gzip",
    "path": [
      "build/client/assets/entry.client-*.js",
      "build/client/assets/root-*.js",
      "build/client/assets/app-core-*.js",
      "build/client/assets/app-shell-*.js",
      "build/client/assets/app-ui-primitives-*.js",
      "build/client/assets/react-vendor-*.js",
      "build/client/assets/lucide-vendor-*.js",
      "build/client/assets/rolldown-runtime-*.js",
      "build/client/assets/site-*.js",
      "build/client/assets/ErrorGeneric-*.js",
      "build/client/assets/LazyFooter-*.js"
    ],
    "limit": "322 KB",
    "gzip": true
  },
  {
    "name": "Total JS (all chunks), gzip",
    "path": "build/client/assets/*.js",
    "limit": "1012 KB",
    "gzip": true
  },
  {
    "name": "Total CSS, gzip",
    "path": "build/client/assets/*.css",
    "limit": "60 KB",
    "gzip": true
  },
  {
    "name": "sentry-vendor chunk, gzip",
    "path": "build/client/assets/sentry-vendor-*.js",
    "limit": "180 KB",
    "gzip": true
  },
  {
    "name": "react-vendor chunk, gzip",
    "path": "build/client/assets/react-vendor-*.js",
    "limit": "110 KB",
    "gzip": true
  },
  {
    "name": "Route R2 produit-v\u00e9hicule (pieces/.../$type.html) chunk, gzip",
    "path": "build/client/assets/pieces._gamme._marque._modele._type_*.js",
    "limit": "34 KB",
    "gzip": true
  },
  {
    "name": "Route R1 gamme (pieces/$slug) chunk, gzip",
    "path": "build/client/assets/pieces._slug-*.js",
    "limit": "16 KB",
    "gzip": true
  }
]
