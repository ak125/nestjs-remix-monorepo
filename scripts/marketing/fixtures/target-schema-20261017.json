  "constraints": [
    {
      "table": "__marketing_social_posts",
      "name": "__marketing_social_posts_brand_gate_level_check",
      "definition": "CHECK ((brand_gate_level = ANY (ARRAY['PASS'::text, 'WARN'::text, 'FAIL'::text])))"
    },
    {
      "table": "__marketing_social_posts",
      "name": "__marketing_social_posts_compliance_gate_level_check",
      "definition": "CHECK ((compliance_gate_level = ANY (ARRAY['PASS'::text, 'WARN'::text, 'FAIL'::text])))"
    },
    {
      "table": "__marketing_social_posts",
      "name": "__marketing_social_posts_content_source_check",
      "definition": "CHECK ((content_source = ANY (ARRAY['gamme_catalogue'::text, 'blog_advice'::text, 'blog_guide'::text, 'promo'::text, 'trust_review'::text, 'seo_recycle'::text])))"
    },
    {
      "table": "__marketing_social_posts",
      "name": "__marketing_social_posts_day_of_week_check",
      "definition": "CHECK (((day_of_week >= 1) AND (day_of_week <= 7)))"
    },
    {
      "table": "__marketing_social_posts",
      "name": "__marketing_social_posts_objective_check",
      "definition": "CHECK ((objective = ANY (ARRAY['traffic'::text, 'engagement'::text, 'conversion'::text, 'awareness'::text])))"
    },
    {
      "table": "__marketing_social_posts",
      "name": "__marketing_social_posts_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table": "__marketing_social_posts",
      "name": "__marketing_social_posts_primary_channel_check",
      "definition": "CHECK ((primary_channel = ANY (ARRAY['instagram'::text, 'facebook'::text, 'youtube'::text])))"
    },
    {
      "table": "__marketing_social_posts",
      "name": "__marketing_social_posts_slot_label_check",
      "definition": "CHECK ((slot_label = ANY (ARRAY['catalogue'::text, 'conseil'::text, 'confiance'::text, 'promo'::text])))"
    },
    {
      "table": "__marketing_social_posts",
      "name": "__marketing_social_posts_status_check",
      "definition": "CHECK ((status = ANY (ARRAY['draft'::text, 'generated'::text, 'gate_pending'::text, 'gate_passed'::text, 'gate_failed'::text, 'approved'::text, 'published'::text, 'archived'::text])))"
    },
    {
      "table": "__marketing_social_posts",
      "name": "__marketing_social_posts_week_iso_check",
      "definition": "CHECK ((week_iso ~ '^\\d{4}-W\\d{2}$'::text))"
    },
    {
      "table": "__marketing_social_posts",
      "name": "chk_msp_gamme_source",
      "definition": "CHECK (((gamme_id IS NULL) OR (content_source IS NOT NULL)))"
    },
    {
      "table": "__marketing_social_posts",
      "name": "chk_msp_utm_source",
      "definition": "CHECK ((utm_source = ANY (ARRAY['instagram'::text, 'facebook'::text, 'youtube'::text])))"
    },
    {
      "table": "__marketing_social_posts",
      "name": "uq_msp_slot",
      "definition": "UNIQUE (week_iso, day_of_week, slot_label, primary_channel)"
    },
    {
      "table": "__marketing_weekly_plans",
      "name": "__marketing_weekly_plans_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table": "__marketing_weekly_plans",
      "name": "__marketing_weekly_plans_status_check",
      "definition": "CHECK ((status = ANY (ARRAY['draft'::text, 'reviewed'::text, 'approved'::text, 'in_progress'::text, 'completed'::text])))"
    },
    {
      "table": "__marketing_weekly_plans",
      "name": "__marketing_weekly_plans_week_iso_check",
      "definition": "CHECK ((week_iso ~ '^\\d{4}-W\\d{2}$'::text))"
    },
    {
      "table": "__marketing_weekly_plans",
      "name": "__marketing_weekly_plans_week_iso_key",
      "definition": "UNIQUE (week_iso)"
    },
    {
      "table": "__marketing_brand_rules",
      "name": "__marketing_brand_rules_channel_check",
      "definition": "CHECK ((channel = ANY (ARRAY['instagram'::text, 'facebook'::text, 'youtube'::text])))"
    },
    {
      "table": "__marketing_brand_rules",
      "name": "__marketing_brand_rules_pkey",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "table": "__marketing_brand_rules",
      "name": "__marketing_brand_rules_rule_type_check",
      "definition": "CHECK ((rule_type = ANY (ARRAY['tone'::text, 'forbidden_word'::text, 'required_element'::text, 'legal'::text, 'visual'::text, 'claims_policy'::text])))"
    },
    {
      "table": "__marketing_brand_rules",
      "name": "__marketing_brand_rules_severity_check",
      "definition": "CHECK ((severity = ANY (ARRAY['block'::text, 'warn'::text, 'info'::text])))"
    }
  ],
  "triggers": [
    {
      "table": "__marketing_social_posts",
      "definition": "CREATE TRIGGER trg_msp_updated_at BEFORE UPDATE ON public.__marketing_social_posts FOR EACH ROW EXECUTE FUNCTION __marketing_set_updated_at()"
