{
  "type": "object",
  "additionalProperties": false,
  "required": ["propositions", "recapitulatif"],
  "properties": {
    "recapitulatif": { "type": "string", "maxLength": 1500 },
    "propositions": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue", "type", "proposition"],
        "properties": {
          "issue": { "type": "integer", "minimum": 1 },
          "type": {
            "type": "string",
            "enum": ["doublon", "sans_departement", "departement_multiple", "blocage", "sans_mouvement"]
          },
          "proposition": { "type": "string", "minLength": 1, "maxLength": 500 },
          "departement_suggere": { "type": "string", "pattern": "^dept:(0[1-9]|1[0-9]|2[0-4])-[a-z]+(-[a-z]+)*$" },
          "doublon_de": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
