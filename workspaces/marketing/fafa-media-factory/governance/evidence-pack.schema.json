{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automecanik.com/schema/fafa-media-factory/evidence-pack.schema.json",
  "title": "Evidence Pack",
  "description": "Artefact #3 — provenance D17 (décision d'ingénierie). Seuls des enregistrements catalogue ou une section WIKI approuvée peuvent soutenir un claim. Une trace historique, une proposition ou une reprise de texte ne constitue pas une preuve.",
  "type": "object",
  "additionalProperties": false,
  "required": ["video_id", "evidence"],
  "properties": {
    "video_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "historical_traces": {
      "type": "array",
      "description": "Anciennes reprises conservées pour audit, jamais transmises comme preuves aux gates.",
      "items": { "$ref": "#/$defs/TraceEntry" }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EvidenceEntry"
      }
    }
  },
  "$defs": {
    "EvidenceEntry": {
      "allOf": [
        { "$ref": "#/$defs/TraceEntry" },
        {
          "if": { "properties": { "source_type": { "const": "catalogue_interne" } }, "required": ["source_type"] },
          "then": { "required": ["data_reference", "extracted_at"] }
        }
      ]
    },
    "SupportingEvidence": {
      "description": "Admissibilité du type de preuve D17; aucun second calcul de vérité par fait.",
      "allOf": [
        { "$ref": "#/$defs/EvidenceEntry" },
        {
          "anyOf": [
            { "properties": { "source_type": { "const": "catalogue_interne" } }, "required": ["data_reference", "extracted_at"] },
            { "properties": { "source_type": { "const": "wiki_diagnostic" } }, "required": ["wiki_reference"] }
          ]
        }
      ]
    },
    "DataReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["table", "key", "query", "extract_sha256", "extract_path"],
      "properties": {
        "table": { "type": "string", "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)?$" },
        "key": { "type": "object", "minProperties": 1, "additionalProperties": { "type": ["string", "number", "boolean"] } },
        "query": { "type": "string", "minLength": 1, "pattern": "\\S", "description": "Requête de l'extraction en lecture seule. Conservée pour audit; jamais exécutée par le validateur." },
        "extract_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "extract_path": { "type": "string", "pattern": "^extracts/[A-Za-z0-9][A-Za-z0-9._/-]*\\.json$", "description": "Fichier JSON de lignes, relatif au dossier pilote; empreinte calculée sur ses octets exacts." }
      }
    },
    "WikiReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "commit", "section", "approved_by", "approved_at"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "section": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "export_path": { "type": "string", "pattern": "^exports/content/gamme/[a-z0-9-]+\\.json$" },
        "export_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "section_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "approved_by": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "approved_at": { "type": "string", "format": "date-time" }
      }
    },
    "TraceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc_id", "source_type", "excerpt", "confidence"],
      "properties": {
        "data_reference": { "$ref": "#/$defs/DataReference" },
        "wiki_reference": { "$ref": "#/$defs/WikiReference" },
        "doc_id": {
          "type": "string",
          "description": "Identifiant unique evidence, ex: wiki-diag-vanne-egr-v1#causes-perte-puissance"
        },
        "source_type": {
          "type": "string",
          "enum": [
            "wiki_diagnostic",
            "wiki_proposal",
            "oem_spec",
            "tecdoc",
            "catalogue_interne",
            "rappel_gouv",
            "norm_ece",
            "expert_humain"
          ]
        },
        "source_url": {
          "type": ["string", "null"],
          "description": "URL ou path interne. Null pour sources non-URL (expert humain, norm payante)."
        },
        "excerpt": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1500,
          "description": "Extrait textuel utilisé comme preuve. PAS de paraphrase Fafa ici, citation brute."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "0=low, 1=high. <0.5 = warning, suggérer validation humaine."
        },
        "extracted_at": {
          "type": "string",
          "format": "date-time"
        },
        "claim_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^claim-[0-9]+$"
          },
          "description": "Liste des claim_id qui s'appuient sur cette evidence (FK reverse)."
        }
      }
    }
  }
}
