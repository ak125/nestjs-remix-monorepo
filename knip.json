{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/audit/impeccable-baseline-write.mjs",
        "scripts/audit/pricing-profitability-projection.ts",
        "scripts/audit/r2-eligibility-calibration.ts",
        "scripts/audit/r2-modele-family-audit.ts",
        "scripts/audit/render-dependency-modernization-matrix.ts",
        "scripts/check-missing-vehicle-images.ts",
        "scripts/ci/prod-admin-guard-probe.mjs",
        "scripts/ci/sample-smoke-urls.ts",
        "scripts/convert-logos.js",
        "scripts/governance/validate-role-coherence.js",
        "scripts/insert-missing-keywords.ts",
        "scripts/marketing/export-publish-queue.ts",
        "scripts/marketing/generate-copy-batch.ts",
        "scripts/marketing/generate-weekly-plan.ts",
        "scripts/marketing/run-reactivation-pilot.ts",
        "scripts/marketing/simulation-no-network.cjs",
        "scripts/seo/audit-cross-gamme-overlap.ts",
        "scripts/seo/backfill-vehicle-page-cache.ts",
        "scripts/seo/build-keyword-clusters.ts",
        "scripts/seo/export-canon-forbidden.ts",
        "scripts/seo/gsc-5xx-evidence-batch.ts",
        "scripts/seo/r1-readiness.ts",
        "scripts/seo/seo-r3-consolidation-evidence.ts",
        "scripts/seo/seo-readiness.ts",
        "scripts/ui-audit/cli.ts",
        "scripts/validate-gamme-schema.ts",
        "scripts/verify-supabase-images.js",
        "scripts/wiki/print-diag-canon-jsonschema.ts",
        "scripts/wiki/validate-proposal.ts",
        "scripts/wiki/verify-diag-canon-parse.ts"
      ],
      "project": ["scripts/**/*.{js,ts,mjs,cjs}"],
      "ignore": [
        "audit-monorepo/**",
        "99-meta/**",
        "output/**",
        "gates/**",
        ".spec/**",
        ".codex",
        ".local/**",
        "scripts/**/__fixtures__/**"
      ]
    },
    "backend": {
      "entry": [
        "src/main.ts",
        "src/main.server.ts",
        "src/app.module.ts",
        "src/workers/main.ts",
        "src/workers/worker.module.ts",
        "src/workers/**/*.ts",
        "scripts/**/*.{js,ts,mjs,cjs}",
        "supabase/migrations/**"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignore": [
        "dist/**",
        "rm/**",
        "**/*.spec.ts",
        "**/*.e2e-spec.ts"
      ],
      "ignoreDependencies": [
        "reflect-metadata",
        "@nestjs/.*"
      ]
    },
    "frontend": {
      "entry": [
        "server.js",
        "app/entry.client.tsx",
        "app/entry.server.tsx",
        "app/root.tsx",
        "app/routes/**/*.{ts,tsx}",
        "app/routes.ts"
      ],
      "project": ["app/**/*.{ts,tsx}"],
      "ignore": [
        "build/**",
        "public/build/**",
        ".cache/**"
      ]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/index.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignoreBinaries": ["turbo", "husky"],
  "rules": {
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "warn",
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn"
  }
}
